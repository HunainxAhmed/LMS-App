# CampusFlow Backend Configuration
PROJECT_NAME="CampusFlow"
API_V1_STR="/api/v1"
DEBUG=true

# Server Host and Port (0.0.0.0 required for Expo / phone access over local Wi-Fi)
HOST=0.0.0.0
PORT=8000

# Database
# Default: SQLite file for local setup, or PostgreSQL: postgresql+psycopg2://user:password@localhost/campusflow
DATABASE_URL=sqlite:///./campusflow.db

# JWT Security
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-campusflow-2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Credential Encryption (AES-256-GCM)
# Must be exactly 32 bytes URL-safe base64 or 32 raw bytes (e.g. Fernet or 32 bytes hex/base64)
# Generate using: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# University Portal Base URLs
BAHRIA_CMS_BASE_URL=https://cms.bahria.edu.pk
BAHRIA_LMS_BASE_URL=https://lms.bahria.edu.pk

# Background Sync Scheduler
DEFAULT_SYNC_INTERVAL_MINUTES=15
MIN_SYNC_INTERVAL_MINUTES=5
MAX_SYNC_WORKERS=3

# Expo Push Notifications
# Set to true to push via Expo Push API; if false, logs push events to console
ENABLE_REMOTE_PUSH=true
